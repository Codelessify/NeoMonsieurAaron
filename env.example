# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Groq ────────────────────────────────────────────────────────────────────
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# ─── RunPod (TTS + Image generation) ─────────────────────────────────────────
# Get from https://www.runpod.io/console/user/settings (API Keys)
# RUNPOD_TTS_ENDPOINT_ID is the ID of your deployed TTS serverless endpoint
# Recommended TTS model: Minimax Speech 02 HD
# Image generation uses the managed FLUX Schnell endpoint (no endpoint ID needed)
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_TTS_ENDPOINT_ID=your_endpoint_id
